{
  "name": "Analista de Tela",
  "description": "Analisa o conteúdo visível da aba atual (DOM e OCR) e compara com uma base de verdades.",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "ui/popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ocr/tesseract.min.js",
        "ocr/worker.min.js",
        "ocr/tesseract.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}